// Prisma schema for linkseek
// 数据库：MySQL 8.0（独立 Docker 容器）

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

/// API Key —— 每个代表一个使用方（如「我的 Claude Code」「老王」）
model ApiKey {
  id          String    @id @default(cuid())
  /// Key 名称，用于展示和统计
  name        String
  /// 明文 key 的 SHA-256 哈希，查询索引用
  tokenHash   String    @unique
  /// 明文 key 前 8 位，列表展示用（如 "wf_1a2b3c"）
  tokenPrefix String
  /// 是否启用
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  usages UsageLog[]

  @@index([enabled])
}

/// 用量记录 —— 每次 MCP 工具调用记一条
model UsageLog {
  id        BigInt   @id @default(autoincrement())
  keyId     String
  /// 被调用的工具名：web_search / web_fetch / web_search_and_fetch
  toolName  String
  /// 调用是否成功
  success   Boolean
  createdAt DateTime @default(now())

  /// AI 工具（web_fetch_answer / web_search_answer）记录所用 Provider，非 AI 工具为 null
  providerId   String?
  /// 调用所用模型名，非 AI 工具为 null
  model        String?
  promptTokens       Int   @default(0)
  completionTokens   Int   @default(0)
  /// 缓存命中 token
  cacheHitTokens     Int   @default(0)
  /// 缓存未命中 token（按全价输入计费）
  cacheMissTokens    Int   @default(0)
  /// 缓存写入 token（Anthropic 等少数模型）
  cacheWriteTokens   Int   @default(0)
  /// 单次调用估算成本（单一货币，由全局 CURRENCY 配置决定币种）
  cost               Float @default(0)

  apiKey ApiKey @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@index([keyId, createdAt])
  @@index([createdAt])
  @@index([providerId])
}

/// LLM Provider —— 配置的 AI 模型供应商（用于 web_fetch_answer / web_search_answer 工具）
model LlmProvider {
  id        String   @id @default(cuid())
  /// 显示名，如「DeepSeek 主力」「Claude 备用」
  name      String
  /// 协议：openai | openai-responses | anthropic | gemini
  protocol  String
  /// API 基地址，如 https://api.deepseek.com/v1
  baseUrl   String
  /// API Key（明文存储，后端需用它调 LLM）
  apiKey    String
  /// 默认模型名，如 deepseek-chat
  model     String
  /// 可用模型列表（JSON 数组字符串，从上游拉取后缓存）
  models    String   @default("[]")
  /// 是否启用
  enabled   Boolean  @default(true)
  /// 是否为默认 Provider（全局唯一）
  isDefault Boolean  @default(false)
  /// 价格配置（JSON：ProviderPricing，含输入/输出/缓存命中/缓存写入单价）
  pricing   String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
}

/// 管理员账号（单一管理员，固定 id=1）
model AdminUser {
  id           Int      @id @default(1)
  /// argon2 哈希后的密码
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
